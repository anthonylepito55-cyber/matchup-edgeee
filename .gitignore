backend/venv/
backend/data_cache/
backend/.env
frontend/node_modules/
__pycache__/
*.pyc

# model_artifacts/ IS committed on purpose — Railway needs the already-trained model files, and
# there's no build step that retrains from scratch on deploy (see deploy notes in README).

# scratch logs/output from ad-hoc runs at repo root, not part of the app
*.log
h_today.json

# RapidAPI key for the tennis stats probe -- never commit a credential
.rapidapi_key
backend/.rapidapi_key

# MCP config holds an API key -- never commit it
.mcp.json

# Goalserve trial token -- never commit a credential
.goalserve_key
backend/.goalserve_key

# API credentials -- read at run time, never committed (2026-10-10: .key2 was NOT ignored)
.key2
backend/.key2
.goalserve_key
backend/.goalserve_key
.livetennis_key
backend/.livetennis_key
.sportsapi365_key
backend/.sportsapi365_key
backend/.key*
